# =========================
# Super JinX Multi-Region
# =========================
# Put these variables on the CENTRAL PANEL service.
# Keep JINX_NODE_SECRET secret and use the exact same value on every regional node.
JINX_NODE_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# JSON array. Replace public domains after you generate domains for the 4 node services.
# Private address is automatically the service's RAILWAY_PRIVATE_DOMAIN, normally <service>.railway.internal.
JINX_REGIONS_JSON=[{"id":"nl","name":"🇳🇱 Netherlands","node_name":"JinX-NL","address":"jinx-nl.railway.internal","port":62050,"public_domain":"REPLACE_NL_DOMAIN"},{"id":"us-east","name":"🇺🇸 USA East","node_name":"JinX-US-East","address":"jinx-us-east.railway.internal","port":62050,"public_domain":"REPLACE_US_EAST_DOMAIN"},{"id":"us-west","name":"🇺🇸 USA West","node_name":"JinX-US-West","address":"jinx-us-west.railway.internal","port":62050,"public_domain":"REPLACE_US_WEST_DOMAIN"},{"id":"sg","name":"🇸🇬 Singapore","node_name":"JinX-SG","address":"jinx-sg.railway.internal","port":62050,"public_domain":"REPLACE_SG_DOMAIN"}]

# Optional: if you want to explicitly pin the shared paths instead of letting nodes fetch them from the panel.
# JINX_SHARED_PATHS_JSON={"JX-VLESS-WS-1":"/ws/CHANGE_ME","JX-VLESS-WS-2":"/stream/CHANGE_ME","JX-TROJAN-WS":"/live/CHANGE_ME","JX-VMESS-WS":"/gw/CHANGE_ME","JX-VLESS-HU":"/cdn/CHANGE_ME"}

# =========================
# Put these on EVERY regional node service
# =========================
JINX_NODE_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JINX_NODE_REGION=nl
JINX_PANEL_DOMAIN=YOUR_PANEL.up.railway.app
