user www-data;
worker_processes 2;
pid /run/nginx.pid;
events { worker_connections 8192; multi_accept on; }
http {
  access_log off;
  error_log /dev/stderr warn;
  sendfile on;
  tcp_nodelay on;
  keepalive_timeout 75s;
  client_max_body_size 0;
  map $http_upgrade $conn_upgrade { default upgrade; '' ''; }
  server {
    listen __PORT__ default_server;
    location = /healthz { return 200 "ok"; }
    location = /ca.pem { alias /var/lib/jinx-node/certs/cert.pem; default_type application/x-pem-file; add_header Cache-Control "public, max-age=3600"; }
    include /etc/nginx/generated-locations.conf;
    # Node management API is intentionally NOT proxied publicly.
    location / { return 404; }
  }
}
